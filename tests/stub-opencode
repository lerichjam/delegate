#!/usr/bin/env bash
# Test double for `opencode`. Behaviour driven by env vars:
#   STUB_EXIT=<n>    exit with this code (default 0)
#   STUB_HANG=<n>    sleep n seconds before exiting (default 0)
#   STUB_CHILD=<n>   spawn a background `sleep n` first, standing in for the
#                    subprocesses a real executor leaves running
#   STUB_NO_AGENT=1  `agent list` omits the executor agent
#   STUB_EDIT=<path>   append to this (tracked) file to simulate an edit
#   STUB_CREATE=<path> create this file to simulate the executor adding a
#                      NEW file -- invisible to `git diff`, which is the case
#                      every STUB_EDIT-based test misses
#   STUB_RUN=<cmd>     eval this shell command last, as an executor's own
#                      bash call would -- e.g. a git command it should not run
# `opencode agent list` is dispatch's preflight probe, not a run.
if [ "${1:-}" = "agent" ]; then
  echo "build (primary)"
  echo "plan (primary)"
  [ -z "${STUB_NO_AGENT:-}" ] && echo "executor (primary)"
  exit 0
fi

echo "stub-opencode invoked with: $*"

# Mirror the one real-CLI quirk that broke dispatch.sh in production: opencode
# run's -f/--file is a yargs *array* option, so it greedily swallows every
# positional argument that follows it, up to the next flag or a `--`
# terminator. Any argument in that span that is not an existing file is a
# hard error in the real CLI, so this stub must reproduce that or it cannot
# catch the class of bug that shipped (message text parsed as a filename).
collecting=0
for arg in "$@"; do
  if [ "$collecting" -eq 1 ]; then
    if [ "$arg" = "--" ]; then
      collecting=0
      continue
    fi
    if [ ! -e "$arg" ]; then
      echo "Error: File not found: $arg" >&2
      exit 20
    fi
    continue
  fi
  if [ "$arg" = "-f" ] || [ "$arg" = "--file" ]; then
    collecting=1
  fi
done

if [ -n "${STUB_CHILD:-}" ]; then
  sleep "${STUB_CHILD}" &
  [ -n "${STUB_CHILD_PIDFILE:-}" ] && echo $! > "${STUB_CHILD_PIDFILE}"
fi
[ "${STUB_HANG:-0}" -gt 0 ] && sleep "${STUB_HANG}"
[ -n "${STUB_EDIT:-}" ] && echo "edited by stub" >> "${STUB_EDIT}"
if [ -n "${STUB_CREATE:-}" ]; then
  mkdir -p "$(dirname "${STUB_CREATE}")"
  printf 'created by stub\n' > "${STUB_CREATE}"
fi
[ -n "${STUB_RUN:-}" ] && eval "${STUB_RUN}" >/dev/null 2>&1
exit "${STUB_EXIT:-0}"
